_fees\"", "batch_results": null}], "elapsed_time": 0.08468079566955566, "args": {"skip_nodes_if_on_run_start_fails": false, "log_level_file": "debug", "introspect": true, "populate_cache": true, "require_explicit_package_overrides_for_builtin_materializations": true, "require_resource_names_without_spaces": true, "validate_macro_args": false, "strict_mode": false, "use_colors_file": true, "invocation_command": "dbt run -m int_transactions_with_fees", "upload_to_artifacts_ingest_api": false, "partial_parse": true, "require_batched_execution_for_custom_microbatch_strategy": false, "defer": false, "profiles_dir": "/Users/jiaen.pan/Projects/prolific/ae-assessment", "vars": {}, "log_path": "/Users/jiaen.pan/Projects/prolific/ae-assessment/logs", "which": "run", "macro_debugging": false, "printer_width": 80, "partial_parse_file_diff": true, "log_level": "info", "show_all_deprecations": false, "log_format_file": "debug", "log_file_max_bytes": 10485760, "source_freshness_run_project_hooks": true, "state_modified_compare_vars": false, "version_check": true, "favor_state": false, "indirect_selection": "eager", "write_json": true, "static_parser": true, "require_nested_cumulative_type_params": false, "print": true, "require_all_warnings_handled_by_warn_error": false, "use_fast_test_edges": false, "cache_selected_only": false, "quiet": false, "log_format": "default", "project_dir": "/Users/jiaen.pan/Projects/prolific/ae-assessment", "empty": false, "show_resource_report": false, "state_modified_compare_more_unrendered_values": false, "require_generic_test_arguments_property": true, "use_colors": true, "warn_error_options": {"error": [], "warn": [], "silence": []}, "send_anonymous_usage_stats": true, "exclude": [], "require_yaml_configuration_for_mf_time_spines": false, "select": ["int_transactions_with_fees"]}}